<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.7.0-preview.3</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../../vendor/desktop-fonts/*.otf" Link="Assets/Fonts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Chinese.txt" LogicalName="Pulse.Desktop.Chinese.txt" />
    <EmbeddedResource Include="ChineseTraditional.txt" LogicalName="Pulse.Desktop.ChineseTraditional.txt" />
    <AvaloniaResource Include="../../../assets/pulse.ico" Link="Assets/pulse.ico" />
    <AvaloniaResource Include="../../../assets/cpu.svg;../../../assets/memory.svg;../../../assets/down.svg;../../../assets/up.svg;../../../assets/codex.svg" Link="Assets/%(Filename)%(Extension)" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <ProjectReference Include="../../Adapters/Linux/Pulse.Adapters.Linux.csproj" />
    <ProjectReference Include="../../Adapters/Mac/Pulse.Adapters.Mac.csproj" />
    <ProjectReference Include="../../Adapters/Windows/Modern/Pulse.Adapters.Windows.Modern.csproj" />
  </ItemGroup>
  <Target Name="RequireDesktopFonts" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../../../vendor/desktop-fonts/NotoSansCJKsc-Regular.otf') Or !Exists('../../../vendor/desktop-fonts/NotoSansCJKtc-Regular.otf')" Text="Prepare pinned fonts first: python scripts/prepare_desktop_fonts.py" />
  </Target>
</Project>
