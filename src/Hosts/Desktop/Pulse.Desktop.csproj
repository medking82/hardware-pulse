<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../../assets/pulse.ico" Link="Assets/pulse.ico" />
    <AvaloniaResource Include="../../../assets/cpu.svg;../../../assets/memory.svg;../../../assets/down.svg;../../../assets/up.svg;../../../assets/codex.svg" Link="Assets/%(Filename)%(Extension)" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <ProjectReference Include="../../Adapters/Linux/Pulse.Adapters.Linux.csproj" />
    <ProjectReference Include="../../Adapters/Mac/Pulse.Adapters.Mac.csproj" />
    <ProjectReference Include="../../Adapters/Windows/Modern/Pulse.Adapters.Windows.Modern.csproj" />
  </ItemGroup>
</Project>
